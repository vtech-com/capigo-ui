{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "baseUrl": ".",
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/components/status-split-pill": ["./src/status-split-pill/status-split-pill.tsx"],
      "@/components/progress-circle": ["./src/progress-circle/progress-circle.tsx"],
      "@/components/confirmation-dialog": ["./src/confirmation-dialog/confirmation-dialog.tsx"],
      "@/components/copy-button": ["./src/copy-button/copy-button.tsx"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vitest.config.ts", "vitest.setup.ts"]
}
