{
  "name": "capigo-ui",
  "version": "0.5.2",
  "private": true,
  "description": "A shadcn registry of Capigo's shared components.",
  "license": "MIT",
  "homepage": "https://github.com/vtech-com/capigo-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vtech-com/capigo-ui.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "shadcn build",
    "typecheck": "tsc --noEmit",
